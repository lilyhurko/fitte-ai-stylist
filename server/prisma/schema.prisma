generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Analysis {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  query String

  geminiResponse String?
  groqResponse   String? @map("mistralResponse")
  fitteResponse  String? @map("ragResponse")

  geminiScore Int?
  groqScore   Int? @map("mistralScore")
  fitteScore  Int? @map("ragScore")

  contextUsed String?

  userId          String                 @db.ObjectId
  user            User                   @relation(fields: [userId], references: [id])
  recommendations OutfitRecommendation[]
  createdAt       DateTime               @default(now())
}

model User {
  id              String                 @id @default(auto()) @map("_id") @db.ObjectId
  email           String                 @unique
  name            String
  gender          String?
  password        String
  styleTags       Json?
  favoriteColors  Json?
  styleWeights    Json?
  colorWeights    Json?
  clothes         Cloth[]
  analyses        Analysis[]
  recommendations OutfitRecommendation[]
  createdAt       DateTime               @default(now())
  events          Event[]
}

model Cloth {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  category           String
  color              String?
  style              String?
  materials          ClothingMaterial[] @default([])
  seasons            ClothingSeason[]   @default([])
  warmthLevel        Int?
  waterResistance    WaterResistance?
  formality          ClothingFormality?
  pattern            ClothingPattern?
  sleeveLength       SleeveLength?
  imageUrl           String?
  cloudinaryPublicId String?
  userId             String             @db.ObjectId
  user               User               @relation(fields: [userId], references: [id])
  createdAt          DateTime           @default(now())
}

model Event {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  date      DateTime
  occasion  String
  formality String

  outfitIds String[] @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OutfitRecommendation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  analysisId String?   @db.ObjectId
  analysis   Analysis? @relation(fields: [analysisId], references: [id])

  clothIds         String[] @db.ObjectId
  score            Float
  scoreDetails     Json
  explanation      String
  algorithmVersion String?
  explanationModel String?
  promptVersion    String?
  selectionSeed    String?
  contextSnapshot  Json?
  generationConfig Json?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
}

enum ClothingMaterial {
  COTTON
  LINEN
  WOOL
  CASHMERE
  SILK
  VISCOSE
  POLYESTER
  POLYAMIDE
  ELASTANE
  ACRYLIC
  DENIM
  LEATHER
  SUEDE
  OTHER
}

enum ClothingSeason {
  SPRING
  SUMMER
  AUTUMN
  WINTER
  ALL_SEASON
}

enum WaterResistance {
  NONE
  WATER_REPELLENT
  WATERPROOF
}

enum ClothingFormality {
  VERY_CASUAL
  CASUAL
  SMART_CASUAL
  BUSINESS
  FORMAL
}

enum ClothingPattern {
  SOLID
  STRIPED
  CHECKERED
  FLORAL
  POLKA_DOT
  ANIMAL_PRINT
  GEOMETRIC
  ABSTRACT
  LOGO
  OTHER
}

enum SleeveLength {
  SLEEVELESS
  SHORT
  THREE_QUARTER
  LONG
  NOT_APPLICABLE
}
